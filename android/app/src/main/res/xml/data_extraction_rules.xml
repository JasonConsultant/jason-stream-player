<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: Nichts in Cloud-Backups oder Geräte-Übertragungen.
     Zugangsdaten sollen das Gerät nie verlassen. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
